# Copy to `.env` at the repo root. Never commit `.env`.
#
# Password-less DATABASE_URL for the ml_pipeline role (test branch / pooler host).
# Put the role password ONLY in DB_ROLE_PASSWORD — never embed it in DATABASE_URL.
DATABASE_URL=postgresql://ml_pipeline@your-test-branch-pooler-host/neondb?sslmode=require
DB_ROLE_PASSWORD=replace-with-ml-pipeline-role-password

# Optional: refuse connect unless hostname contains this substring (test-branch safety).
# DB_HOST_MUST_CONTAIN=ep-your-test-endpoint

# Optional overrides for listing tables / source filter.
# Defaults are canonical schema-qualified names. Known legacy bare aliases
# still resolve via the allowlist in shared_scripts/canonical_db.py.
SALE_TABLE=market.sale_listings
RENTAL_TABLE=market.rental_listings
TREND_TABLE=market.price_observations
DEMOGRAPHICS_TABLE=geo.neighborhood_demographics
# Provenance filter for listing rows. Must match market.*_listings.source_site.
SOURCE_SITE=

# Optional: Google Earth Engine Cloud project id (required by newer earthengine-api).
# Register at https://code.earthengine.google.com/register then set:
# EE_PROJECT=your-gcp-project-id
EE_PROJECT=
